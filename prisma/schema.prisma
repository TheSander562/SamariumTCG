// SamariumTCG data model

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Card catalog (synced from external API / admin) ---

model Expansion {
  id          String    @id @default(cuid())
  externalId  String    @unique
  code        String?
  name        String
  series      String?
  releaseDate DateTime?
  totalCards  Int       @default(0)
  cards       Card[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([name])
}

model Card {
  id              String           @id @default(cuid())
  externalId      String           @unique
  expansionId     String
  expansion       Expansion        @relation(fields: [expansionId], references: [id], onDelete: Cascade)
  name            String
  number          String?
  rarity          String?
  supertype       String?
  hp              Int?
  types           String[]
  artist          String?
  imageUrl        String?
  imageCachedPath String?
  collectionItems CollectionItem[]
  binderSlots     BinderSlot[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([name])
  @@index([expansionId, number])
  @@index([rarity])
}

// --- User collection ---

model CollectionItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  condition String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, cardId])
  @@index([userId])
}

// --- Virtual binders ---

model Binder {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  slots       BinderSlot[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId])
}

model BinderSlot {
  id       String  @id @default(cuid())
  binderId String
  binder   Binder  @relation(fields: [binderId], references: [id], onDelete: Cascade)
  cardId   String?
  card     Card?   @relation(fields: [cardId], references: [id], onDelete: SetNull)
  page     Int     @default(0)
  slot     Int     @default(0)

  @@unique([binderId, page, slot])
  @@index([binderId])
}
// --- User setup ---

enum UserRole {
  USER
  ADMIN
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

// --- BetterAuth ---

model User {
  id            String           @id
  name          String
  email         String
  emailVerified Boolean          @default(false)
  image         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  sessions      Session[]
  accounts      Account[]
  theme         Theme            @default(SYSTEM)
  locale        String           @default("en")
  role          UserRole         @default(USER)
  collection    CollectionItem[]
  binders       Binder[]

  passkeys      Passkey[]
  twoFactorEnabled Boolean?
  twofactors    TwoFactor[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

model TwoFactor {
  id                       String    @id
  userId                   String
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret                   String
  backupCodes              String
  verified                 Boolean   @default(false)
  failedVerificationCount  Int       @default(0)
  lockedUntil              DateTime?

  @@index([userId])
  @@map("twoFactor")
}
